{
  "name": "cronify",
  "version": "1.0.1",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rimraf dist && rimraf out && rimraf ui/* && rimraf .*.bun-build",
    "dev-build": "bun ./scripts/build.ts",
    "build": "bun ./scripts/build.ts",
    "format": "prettier . --write",
    "install-deps": "bun i && cd frontend && bun i"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "cron-parser": "^5.5.0"
  }
}
